<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Online Shop</title>
    <link rel="stylesheet" href="/stylesheets/login/login.css">
</head>
<body>
    <div class="auth-container">
        <div class="auth-wrapper">
            <div class="auth-brand">
                <div class="brand-content">
                    <h1 class="brand-logo">Umbrella</h1>
                    <p class="brand-tagline">Your premium online store</p>
                    <div class="brand-features">
                        <div class="feature">
                            <svg viewBox="0 0 24 24" width="24" height="24">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="currentColor"/>
                            </svg>
                            <span>Secure checkout</span>
                        </div>
                        <div class="feature">
                            <svg viewBox="0 0 24 24" width="24" height="24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                            </svg>
                            <span>Fast delivery</span>
                        </div>
                        <div class="feature">
                            <svg viewBox="0 0 24 24" width="24" height="24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/>
                            </svg>
                            <span>24/7 Support</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-forms">
                <div class="auth-tabs">
                    <a href="sign-in" class="tab-button active">
                        <span>Sign In</span>
                    </a>
                    <a href="sign-up" class="tab-button">
                        <span>Sign Up</span>
                    </a>
                </div>

                <div class="tab-content active" id="login-tab">
                    <div class="form-header">
                        <h2>Welcome Back</h2>
                        <p>Sign in to access your account</p>
                    </div>

                    <form id="form" class="auth-form">
                        <div class="form-group">
                            <label for="login-email">Email Address</label>
                            <input 
                                type="email" 
                                id="login-email" 
                                name="email" 
                                placeholder="example@mail.com"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label for="login-password">Password</label>
                            <div class="password-input-wrapper">
                                <input 
                                    type="password" 
                                    id="login-password" 
                                    name="password" 
                                    placeholder="••••••••"
                                    required
                                >
                            </div>
                        </div>

                        <div class="form-options">
                            <label class="checkbox-group">
                                <input type="checkbox" name="remember" id="remember">
                                <span>Remember me</span>
                            </label>
                        </div>
                        <button type="submit" class="btn-submit">Sign In</button>

                        <div class="divider">
                            <span>Or continue with</span>
                        </div>

                        <div class="social-buttons">
                            <button type="button" class="btn-social">
                                <svg viewBox="0 0 24 24" width="20" height="20">
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                                </svg>
                                Google
                            </button>
                            <button type="button" class="btn-social">
                                <svg viewBox="0 0 24 24" width="20" height="20">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" fill="currentColor"/>
                                </svg>
                                GitHub
                            </button>
                        </div>

                        <p class="form-footer">
                            Don't have an account? <a href="sign-up">Sign up</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="/javascripts/login/index.js"></script>
</body>
</html>